@startuml arquitetura

title CampusReserva: arquitetura da solução (BaaS, sem servidor próprio)

skinparam monochrome true
skinparam shadowing false
skinparam componentStyle rectangle
left to right direction

actor "Utilizador\nou gestor" as pessoa
actor "Equipa de\ndesenvolvimento" as equipa

node "Browser" as browser {
  component "Aplicação web\nHTML, CSS e JavaScript\nSDK Firebase 10.4.0 por CDN" as app
}

cloud "Firebase: projeto campusreservage, plano Spark" as firebase {
  component "Firebase Hosting\nserve a pasta public/\ncanal live: campusreservage.web.app\ncanais de pré-visualização dos PR" as hosting
  component "Firebase Authentication\nemail e palavra-passe" as auth
  component "Security Rules\nfirestore.rules" as rules
  database "Cloud Firestore\nusers, resources,\nreservations, reservationSlots" as db
}

node "GitHub" as github {
  component "Repositório\ndiogofcpereira/CampusReserva" as repo
  component "GitHub Actions" as actions
}

pessoa --> app : usa
app --> hosting : 1. Carrega a aplicação
app --> auth : 2. Cria conta e inicia sessão
app --> rules : 3. Lê e escreve dados\ncom o token da sessão
auth ..> rules : identidade de quem pede\n(request.auth)
rules --> db : só passa o que\nas regras permitem

equipa --> repo : push para main\nou pull request
repo --> actions : dispara o workflow
actions --> rules : push para main: publica as regras\ndepois de os testes passarem
actions --> hosting : push para main: canal live\npull request: canal de pré-visualização

note bottom of hosting
  Uma pré-visualização corre fora de localhost, por isso
  usa a Authentication e o Firestore de produção,
  com as regras que já estão publicadas.
end note

legend
  Não existe servidor próprio: a lógica corre no browser
  e a segurança é imposta pelas Security Rules.
endlegend
@enduml
