@startuml arquitetura

title CampusReserva: arquitetura da solução (BaaS)

skinparam monochrome true
skinparam shadowing false
skinparam componentStyle rectangle


actor "Utilizador\nou gestor" as pessoa
actor "Equipa de\ndesenvolvimento" as equipa

node "Browser" as browser {
  component "Aplicação web" as app
}

cloud "Firebase" as firebase {
  component "Firebase Hosting\ncampusreservage.web.app" as hosting
  component "Firebase Authentication\nemail e palavra-passe" as auth
  component "Security Rules\nfirestore.rules" as rules
  database "Cloud Firestore\nusers, resources,\nreservations, reservationSlots" as db
}

node "GitHub" as github {
  component "Repositório\ndiogofcpereira/CampusReserva" as repo
  component "GitHub Actions" as actions
}

pessoa --> app : usa
app --> hosting : 1. Carrega a aplicação
app --> auth : 2. Cria conta e inicia sessão
app --> rules : 3. Lê e escreve dados\ncom o token da sessão
auth ..> rules : identidade de quem pede\n(request.auth)
rules --> db : só passa o que\nas regras permitem

equipa --> repo : push para main
repo --> actions : dispara o workflow
actions --> rules : publica as regras\ndepois de os testes passarem
actions --> hosting : publica a aplicação\ndepois das regras

@enduml
