@startuml modelo-dados

title CampusReserva: modelo de dados (Cloud Firestore)

skinparam monochrome true
skinparam shadowing false
skinparam classAttributeIconSize 0
hide circle
hide empty members

class "users" as User <<coleção>> {
  ID do documento: UID da conta na Authentication
  --
  uid : string
  email : string
  displayName : string
  role : string
  createdAt : timestamp
  updatedAt : timestamp
}

class "resources" as Resource <<coleção>> {
  ID do documento: gerado pelo Firestore
  --
  name : string
  type : string
  location : string
  capacity : int
  description : string
  active : boolean
  createdAt : timestamp
  updatedAt : timestamp
}

class "reservations" as Reservation <<coleção>> {
  ID do documento: gerado pelo Firestore
  --
  userId : string
  resourceId : string
  resourceName : string
  resourceType : string
  date : string
  startTime : string
  endTime : string
  durationMinutes : int
  unitNumber : int
  slotId : string
  slotIds : lista de string
  status : string
  createdAt : timestamp
  .. só depois de cancelada ..
  cancelledAt : timestamp
  cancelledBy : string
  cancelReason : string
}

class "reservationSlots" as Slot <<coleção>> {
  ID do documento: determinístico
  --
  reservationId : string
  resourceId : string
  date : string
  startTime : string
  unitNumber : int
}

User "0..1" -- "0..*" Reservation : userId
User "0..1" -- "0..*" Reservation : cancelledBy
Resource "1" -- "0..*" Reservation : resourceId
Reservation "1" *-- "0..6" Slot : slotIds e reservationId
Resource "1" -- "0..*" Slot : resourceId

note right of Resource
  capacity tem dois significados:
  numa sala, o número de lugares, e é opcional;
  num equipamento, o número de unidades,
  cada uma reservável em separado.
  Desativar um recurso cancela as suas reservas
  por realizar.
end note

@enduml
