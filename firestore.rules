rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isManager() {
      return signedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'gestor';
    }

    function validStartTime(time) {
      return time in [
        '08:00', '08:30', '09:00', '09:30', '10:00', '10:30',
        '11:00', '11:30', '12:00', '12:30', '13:00', '13:30',
        '14:00', '14:30', '15:00', '15:30', '16:00', '16:30',
        '17:00', '17:30', '18:00', '18:30', '19:00', '19:30',
        '20:00', '20:30', '21:00', '21:30'
      ];
    }

    // Exige uma data real no formato AAAA-MM-DD e rejeita texto livre.
    function validDate(value) {
      return value is string
        && value.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && int(value.split('-')[0]) >= 1
        && (
          (value.split('-')[1] in ['01', '03', '05', '07', '08', '10', '12']
            && int(value.split('-')[2]) >= 1
            && int(value.split('-')[2]) <= 31)
          ||
          (value.split('-')[1] in ['04', '06', '09', '11']
            && int(value.split('-')[2]) >= 1
            && int(value.split('-')[2]) <= 30)
          ||
          (value.split('-')[1] == '02'
            && int(value.split('-')[2]) >= 1
            && int(value.split('-')[2]) <= 28)
          ||
          (value.split('-')[1] == '02'
            && int(value.split('-')[2]) == 29
            && (int(value.split('-')[0]) % 400 == 0
              || (int(value.split('-')[0]) % 4 == 0
                && int(value.split('-')[0]) % 100 != 0)))
        );
    }

    function validDuration(durationMinutes) {
      return durationMinutes in [30, 60, 90, 120, 150, 180];
    }

    // [CORRIGIDO] Aritmética de minutos em vez de cadeias de nextTime(): as cadeias
    // ultrapassavam o limite de 1000 expressões avaliadas por pedido nas durações longas.
    function toMinutes(time) {
      return int(time.split(':')[0]) * 60 + int(time.split(':')[1]);
    }

    function twoDigits(n) {
      return n < 10 ? '0' + string(n) : string(n);
    }

    function fromMinutes(total) {
      return twoDigits(int((total - total % 60) / 60)) + ':' + twoDigits(total % 60);
    }

    function endTimeFor(time, durationMinutes) {
      return fromMinutes(toMinutes(time) + durationMinutes);
    }

    function slotDocumentId(resourceId, date, time, resourceType, unitNumber) {
      return resourceType == 'equipamento'
        ? resourceId + '_' + date + '_' + time + '_unit_' + string(unitNumber)  // [CORRIGIDO] string + int dava erro
        : resourceId + '_' + date + '_' + time;
    }

    function validCapacity(data) {
      return data.type == 'equipamento'
        ? data.keys().hasAny(['capacity'])
          && data.capacity is int
          && data.capacity >= 1
          && data.capacity <= 1000
        : (
          !data.keys().hasAny(['capacity'])
          || data.capacity == null
          || (data.capacity is int && data.capacity >= 1 && data.capacity <= 1000)
        );
    }

    // Recursos antigos criados manualmente podem não ter createdAt.
    // Nesse caso, uma edição não tem de inventar nem comparar um campo inexistente.
    function createdAtUnchanged() {
      return (
        !resource.data.keys().hasAny(['createdAt'])
        && !request.resource.data.keys().hasAny(['createdAt'])
      ) || (
        resource.data.keys().hasAny(['createdAt'])
        && request.resource.data.keys().hasAny(['createdAt'])
        && request.resource.data.createdAt == resource.data.createdAt
      );
    }

    // Um equipamento antigo sem capacity é tratado como uma única unidade.
    // Se capacity existir, tem obrigatoriamente de ser um inteiro positivo.
    function validReservationUnit(resourceData, reservationData) {
      return (
        reservationData.resourceType == 'sala'
        && reservationData.unitNumber == 1
      ) || (
        reservationData.resourceType == 'equipamento'
        && (
          // [CORRIGIDO] equipamento sem capacity ou com capacity null conta como 1 unidade (como no dashboard.js)
          (resourceData.get('capacity', null) == null && reservationData.unitNumber == 1)
          || (
            resourceData.get('capacity', null) is int
            && resourceData.capacity >= 1
            && reservationData.unitNumber <= resourceData.capacity
          )
        )
      );
    }

    function reservationHasSlot(data, slotId) {
      return data.keys().hasAny(['slotIds'])
        ? data.slotIds is list && data.slotIds.hasAny([slotId])
        : data.slotId == slotId;
    }

    // [SIMPLIFICADO] A reserva só confirma que cada bloqueio da lista existe no fim da operação e
    // aponta para ela. Que cada bloqueio tem o ID certo e está dentro do intervalo da reserva é
    // verificado na regra de reservationSlots (cada bloqueio tem o seu próprio limite de avaliação).
    // Antes, verificar tudo aqui ultrapassava o limite de 1000 expressões nas reservas de 2h30 e 3h.
    function lockBelongs(slotIds, reservationId, index) {
      return getAfter(/databases/$(database)/documents/reservationSlots/$(slotIds[index])).data.reservationId == reservationId;
    }

    // Uma reserva de N meias horas tem exatamente N bloqueios diferentes (máximo 6 = 3 horas).
    function reservationLocksMatch(data, reservationId) {
      return data.slotIds is list
        && data.slotIds.size() >= 1
        && data.slotIds.size() <= 6
        && data.slotIds.size() * 30 == data.durationMinutes
        && data.slotIds.toSet().size() == data.slotIds.size()
        && data.slotId == data.slotIds[0]
        && lockBelongs(data.slotIds, reservationId, 0)
        && (data.slotIds.size() < 2 || lockBelongs(data.slotIds, reservationId, 1))
        && (data.slotIds.size() < 3 || lockBelongs(data.slotIds, reservationId, 2))
        && (data.slotIds.size() < 4 || lockBelongs(data.slotIds, reservationId, 3))
        && (data.slotIds.size() < 5 || lockBelongs(data.slotIds, reservationId, 4))
        && (data.slotIds.size() < 6 || lockBelongs(data.slotIds, reservationId, 5));
    }

    // [NOVO] Um bloqueio só é válido se a sua meia hora estiver dentro do intervalo da reserva.
    function lockInsideReservation(lockData, reservationData) {
      return toMinutes(lockData.startTime) >= toMinutes(reservationData.startTime)
        && toMinutes(lockData.startTime) < toMinutes(reservationData.endTime);
    }

    function reservationLocksRemoved(data) {
      return data.keys().hasAny(['slotIds'])
        ? data.slotIds is list
          && data.slotIds.size() >= 1
          && data.slotIds.size() <= 6
          && !existsAfter(/databases/$(database)/documents/reservationSlots/$(data.slotIds[0]))
          && (data.slotIds.size() < 2 || !existsAfter(/databases/$(database)/documents/reservationSlots/$(data.slotIds[1])))
          && (data.slotIds.size() < 3 || !existsAfter(/databases/$(database)/documents/reservationSlots/$(data.slotIds[2])))
          && (data.slotIds.size() < 4 || !existsAfter(/databases/$(database)/documents/reservationSlots/$(data.slotIds[3])))
          && (data.slotIds.size() < 5 || !existsAfter(/databases/$(database)/documents/reservationSlots/$(data.slotIds[4])))
          && (data.slotIds.size() < 6 || !existsAfter(/databases/$(database)/documents/reservationSlots/$(data.slotIds[5])))
        : !existsAfter(/databases/$(database)/documents/reservationSlots/$(data.slotId));
    }

    match /users/{userId} {
      allow read: if signedIn() && (request.auth.uid == userId || isManager());

      // Um perfil criado a partir do browser tem de corresponder à conta autenticada.
      allow create: if signedIn()
        && request.auth.uid == userId
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.email is string
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.role == 'utilizador'
        && request.resource.data.keys().hasOnly(['uid', 'email', 'displayName', 'role', 'createdAt', 'updatedAt']);

      allow update: if (
          isManager()
          && request.auth.uid != userId
          && request.resource.data.role in ['utilizador', 'gestor']
          && request.resource.data.get('uid', userId) == resource.data.get('uid', userId)
          && request.resource.data.get('email', '') == resource.data.get('email', '')
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['role', 'updatedAt'])
        ) || (
          signedIn()
          && request.auth.uid == userId
          && request.resource.data.role == resource.data.role
          && request.resource.data.get('uid', userId) == resource.data.get('uid', userId)
          && request.resource.data.get('email', '') == resource.data.get('email', '')
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['displayName', 'updatedAt'])
        );

      allow delete: if false;
    }

    match /resources/{resourceId} {
      allow read: if signedIn() && (resource.data.active == true || isManager());

      allow create: if isManager()
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 90
        && request.resource.data.type in ['sala', 'equipamento']
        && request.resource.data.location is string
        && request.resource.data.active is bool
        && validCapacity(request.resource.data)
        && request.resource.data.keys().hasOnly(['name', 'type', 'location', 'capacity', 'description', 'active', 'createdAt', 'updatedAt']);

      allow update: if isManager()
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 90
        && request.resource.data.type in ['sala', 'equipamento']
        && request.resource.data.location is string
        && request.resource.data.active is bool
        && validCapacity(request.resource.data)
        && createdAtUnchanged()
        && request.resource.data.keys().hasOnly(['name', 'type', 'location', 'capacity', 'description', 'active', 'createdAt', 'updatedAt']);

      allow delete: if false;
    }

    match /reservations/{reservationId} {
      allow read: if signedIn() && (resource.data.userId == request.auth.uid || isManager());

      allow create: if signedIn()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.status == 'ativa'
        && request.resource.data.resourceId is string
        && validDate(request.resource.data.date)
        && validStartTime(request.resource.data.startTime)
        && validDuration(request.resource.data.durationMinutes)
        && request.resource.data.endTime == endTimeFor(request.resource.data.startTime, request.resource.data.durationMinutes)
        && request.resource.data.resourceType in ['sala', 'equipamento']
        && request.resource.data.resourceName is string
        && request.resource.data.unitNumber is int
        && request.resource.data.unitNumber >= 1
        && exists(/databases/$(database)/documents/resources/$(request.resource.data.resourceId))
        && get(/databases/$(database)/documents/resources/$(request.resource.data.resourceId)).data.active == true
        && get(/databases/$(database)/documents/resources/$(request.resource.data.resourceId)).data.name == request.resource.data.resourceName
        && get(/databases/$(database)/documents/resources/$(request.resource.data.resourceId)).data.type == request.resource.data.resourceType
        && validReservationUnit(
          get(/databases/$(database)/documents/resources/$(request.resource.data.resourceId)).data,
          request.resource.data
        )
        && reservationLocksMatch(request.resource.data, reservationId)
        && request.resource.data.keys().hasOnly(['userId', 'resourceId', 'resourceName', 'resourceType', 'date', 'startTime', 'endTime', 'durationMinutes', 'unitNumber', 'slotId', 'slotIds', 'status', 'createdAt']);

      // Cancelar só altera estado/data e elimina todos os bloqueios na mesma transação.
      allow update: if signedIn()
        && (resource.data.userId == request.auth.uid || isManager())
        && resource.data.status == 'ativa'
        && request.resource.data.status == 'cancelada'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'cancelledAt'])
        && reservationLocksRemoved(resource.data);

      allow delete: if false;
    }

    match /reservationSlots/{slotId} {
      allow read: if signedIn();

      allow create: if signedIn()
        && request.resource.data.resourceId is string
        && validDate(request.resource.data.date)
        && validStartTime(request.resource.data.startTime)
        && request.resource.data.unitNumber is int
        && request.resource.data.unitNumber >= 1
        && request.resource.data.keys().hasOnly(['reservationId', 'resourceId', 'date', 'startTime', 'unitNumber'])
        && existsAfter(/databases/$(database)/documents/reservations/$(request.resource.data.reservationId))
        && getAfter(/databases/$(database)/documents/reservations/$(request.resource.data.reservationId)).data.userId == request.auth.uid
        && getAfter(/databases/$(database)/documents/reservations/$(request.resource.data.reservationId)).data.status == 'ativa'
        && getAfter(/databases/$(database)/documents/reservations/$(request.resource.data.reservationId)).data.resourceId == request.resource.data.resourceId
        && getAfter(/databases/$(database)/documents/reservations/$(request.resource.data.reservationId)).data.date == request.resource.data.date
        && getAfter(/databases/$(database)/documents/reservations/$(request.resource.data.reservationId)).data.unitNumber == request.resource.data.unitNumber
        && getAfter(/databases/$(database)/documents/reservations/$(request.resource.data.reservationId)).data.resourceType == get(/databases/$(database)/documents/resources/$(request.resource.data.resourceId)).data.type
        && reservationHasSlot(getAfter(/databases/$(database)/documents/reservations/$(request.resource.data.reservationId)).data, slotId)
        && lockInsideReservation(request.resource.data, getAfter(/databases/$(database)/documents/reservations/$(request.resource.data.reservationId)).data)
        && slotId == slotDocumentId(
          request.resource.data.resourceId,
          request.resource.data.date,
          request.resource.data.startTime,
          getAfter(/databases/$(database)/documents/reservations/$(request.resource.data.reservationId)).data.resourceType,
          request.resource.data.unitNumber
        );

      allow update: if false;

      allow delete: if signedIn()
        && existsAfter(/databases/$(database)/documents/reservations/$(resource.data.reservationId))
        && getAfter(/databases/$(database)/documents/reservations/$(resource.data.reservationId)).data.status == 'cancelada'
        && (getAfter(/databases/$(database)/documents/reservations/$(resource.data.reservationId)).data.userId == request.auth.uid || isManager())
        && reservationHasSlot(
          getAfter(/databases/$(database)/documents/reservations/$(resource.data.reservationId)).data,
          slotId
        );
    }
  }
}
